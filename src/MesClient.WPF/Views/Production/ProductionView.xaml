<UserControl x:Class="MesClient.WPF.Views.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 페이지 헤더 -->
        <TextBlock Text="생산관리" Style="{StaticResource PageTitle}" Grid.Row="0" />

        <!-- 검색 조건 -->
        <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 기간 -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="시작일" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <DatePicker SelectedDate="{Binding FromDate}" Width="120" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="종료일" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <DatePicker SelectedDate="{Binding ToDate}" Width="120" />
                </StackPanel>

                <!-- 상태 -->
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="상태" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox Width="120"
                              SelectedItem="{Binding SelectedStatus}"
                              materialDesign:HintAssist.Hint="전체">
                        <ComboBoxItem Content="전체" />
                        <ComboBoxItem Content="계획" />
                        <ComboBoxItem Content="대기" />
                        <ComboBoxItem Content="진행중" />
                        <ComboBoxItem Content="완료" />
                    </ComboBox>
                </StackPanel>

                <!-- 라인 -->
                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text="라인" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox Width="120"
                              ItemsSource="{Binding LineCodes}"
                              SelectedItem="{Binding SelectedLineCode}"
                              materialDesign:HintAssist.Hint="전체" />
                </StackPanel>

                <!-- 검색어 -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="검색" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 버튼들 -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Content="초기화"
                            Command="{Binding ClearFiltersCommand}"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SearchCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" />
                            <TextBlock Text="조회" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- 메인 컨텐츠 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- 작업지시 목록 -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,8,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 헤더 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="작업지시 목록" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Content="시작"
                                    Command="{Binding StartWorkOrderCommand}"
                                    IsEnabled="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Content="일시정지"
                                    Command="{Binding PauseWorkOrderCommand}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                    Content="완료"
                                    Command="{Binding CompleteWorkOrderCommand}" />
                        </StackPanel>
                        <Border />
                    </DockPanel>

                    <!-- 그리드 -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding WorkOrders}"
                              SelectedItem="{Binding SelectedWorkOrder}"
                              Style="{StaticResource MesDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="작업지시번호" Binding="{Binding WorkOrderNo}" Width="130" />
                            <DataGridTextColumn Header="제품코드" Binding="{Binding ProductCode}" Width="100" />
                            <DataGridTextColumn Header="제품명" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="라인" Binding="{Binding LineName}" Width="80" />
                            <DataGridTextColumn Header="목표수량" Binding="{Binding PlanQuantity, StringFormat=N0}" Width="80" />
                            <DataGridTextColumn Header="생산수량" Binding="{Binding ProducedQuantity, StringFormat=N0}" Width="80" />
                            <DataGridTextColumn Header="불량수량" Binding="{Binding DefectQuantity, StringFormat=N0}" Width="80" />
                            <DataGridTemplateColumn Header="진행률" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar Value="{Binding ProgressRate}" Maximum="100" Height="20" />
                                            <TextBlock Text="{Binding ProgressRate, StringFormat={}{0:F1}%}" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="상태" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource WorkOrderStatusToColorConverter}}"
                                                CornerRadius="4"
                                                Padding="8,4">
                                            <TextBlock Text="{Binding Status}" 
                                                       Foreground="White" 
                                                       FontSize="11"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="시작시간" Binding="{Binding ActualStartTime, StringFormat=HH:mm}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 요약 정보 -->
                    <Border Grid.Row="2" 
                            BorderThickness="0,1,0,0" 
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            Padding="0,8,0,0"
                            Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="총" />
                                <Run Text="{Binding WorkOrders.Count}" FontWeight="Bold" />
                                <Run Text="건" />
                            </TextBlock>
                            <TextBlock Margin="24,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{Binding Summary, Converter={StaticResource NullToVisibilityConverter}}">
                                <Run Text="| 달성률:" />
                                <Run Text="{Binding Summary.AchievementRate, StringFormat=F1}" FontWeight="Bold" />
                                <Run Text="%" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- 상세 정보 -->
            <materialDesign:Card Grid.Column="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="생산 실적" Style="{StaticResource SectionTitle}" Grid.Row="0" />

                    <!-- 선택된 작업지시가 있을 때 -->
                    <Grid Grid.Row="1" Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 작업지시 정보 -->
                        <Border Grid.Row="0" 
                                Background="{StaticResource BackgroundBrush}"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedWorkOrder.WorkOrderNo}" 
                                           FontSize="16" 
                                           FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedWorkOrder.ProductName}" 
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock>
                                        <Run Text="목표:" />
                                        <Run Text="{Binding SelectedWorkOrder.PlanQuantity, StringFormat=N0}" FontWeight="Bold" />
                                    </TextBlock>
                                    <TextBlock Margin="16,0,0,0">
                                        <Run Text="실적:" />
                                        <Run Text="{Binding SelectedWorkOrder.ProducedQuantity, StringFormat=N0}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Margin="16,0,0,0">
                                        <Run Text="불량:" />
                                        <Run Text="{Binding SelectedWorkOrder.DefectQuantity, StringFormat=N0}" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 생산 실적 목록 -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Productions}"
                                  Style="{StaticResource MesDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시간" Binding="{Binding ProductionTime, StringFormat=HH:mm:ss}" Width="80" />
                                <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="100" />
                                <DataGridTextColumn Header="수량" Binding="{Binding Quantity, StringFormat=N0}" Width="60" />
                                <DataGridTextColumn Header="불량" Binding="{Binding DefectQuantity, StringFormat=N0}" Width="60" />
                                <DataGridTextColumn Header="작업자" Binding="{Binding OperatorName}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- 선택된 작업지시가 없을 때 -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                        <materialDesign:PackIcon Kind="Clipboard" 
                                                 Width="64" Height="64"
                                                 Foreground="{StaticResource TextDisabledBrush}"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="작업지시를 선택하세요"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,16,0,0" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
