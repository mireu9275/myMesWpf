<UserControl x:Class="MesClient.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 로그인 카드 -->
        <materialDesign:Card Grid.Column="1"
                             VerticalAlignment="Center"
                             Padding="32"
                             UniformCornerRadius="16"
                             materialDesign:ElevationAssist.Elevation="Dp8">
            <StackPanel>
                <!-- 로고/타이틀 -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                    <materialDesign:PackIcon Kind="Factory" 
                                             Width="64" Height="64" 
                                             HorizontalAlignment="Center"
                                             Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="MES Client" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                    <TextBlock Text="Manufacturing Execution System" 
                               FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 사용자 ID -->
                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="사용자 ID"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Account"
                         Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16" />

                <!-- 비밀번호 -->
                <PasswordBox Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             materialDesign:HintAssist.Hint="비밀번호"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Lock"
                             materialDesign:PasswordBoxAssist.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" />

                <!-- 자동 로그인 -->
                <CheckBox Content="사용자 ID 저장"
                          IsChecked="{Binding RememberMe}"
                          Margin="0,0,0,24" />

                <!-- 오류 메시지 -->
                <TextBlock Text="{Binding LoginError}"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding LoginError, Converter={StaticResource NullToVisibilityConverter}}"
                           Margin="0,0,0,16" />

                <!-- 로그인 버튼 -->
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="로그인"
                        Command="{Binding LoginCommand}"
                        Height="48"
                        FontSize="16"
                        IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InverseBoolConverter}}" />

                <!-- 로딩 표시 -->
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVisibilityConverter}}"
                             HorizontalAlignment="Center"
                             Margin="0,16,0,0" />
            </StackPanel>
        </materialDesign:Card>

        <!-- 버전 정보 -->
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11">
            <Run Text="Version 1.0.0" />
            <Run Text=" | " />
            <Run Text="© 2024 Your Company" />
        </TextBlock>
    </Grid>
</UserControl>
