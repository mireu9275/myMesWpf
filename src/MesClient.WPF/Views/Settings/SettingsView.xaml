<UserControl x:Class="MesClient.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800">
            <!-- 페이지 헤더 -->
            <TextBlock Text="설정" Style="{StaticResource PageTitle}" />

            <!-- 사용자 정보 -->
            <materialDesign:Card Padding="24" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="80" Height="80"
                            CornerRadius="40"
                            Background="{StaticResource PrimaryBrush}"
                            Margin="0,0,24,0">
                        <materialDesign:PackIcon Kind="Account" 
                                                 Width="48" Height="48"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUser.UserName}" 
                                   FontSize="20" 
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding CurrentUser.Department}" 
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                            <Run Text="ID:" />
                            <Run Text="{Binding CurrentUser.UserId}" />
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="비밀번호 변경"
                            Command="{Binding ChangePasswordCommand}"
                            VerticalAlignment="Center" />
                </Grid>
            </materialDesign:Card>

            <!-- 테마 설정 -->
            <materialDesign:Card Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="테마 설정" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />

                    <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding IsDarkTheme}">
                        <materialDesign:ToggleButtonAssist.OnContent>
                            <materialDesign:PackIcon Kind="WeatherNight" />
                        </materialDesign:ToggleButtonAssist.OnContent>
                        <materialDesign:PackIcon Kind="WhiteBalanceSunny" />
                    </ToggleButton>
                    <TextBlock Text="다크 모드" Margin="8,0,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 알림 설정 -->
            <materialDesign:Card Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="알림 설정" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />

                    <CheckBox Content="알림 활성화"
                              IsChecked="{Binding EnableNotifications}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="알림음 사용"
                              IsChecked="{Binding EnableSoundAlerts}"
                              IsEnabled="{Binding EnableNotifications}"
                              Margin="24,0,0,8" />
                    <CheckBox Content="데스크톱 알림 표시"
                              IsChecked="{Binding EnableDesktopAlerts}"
                              IsEnabled="{Binding EnableNotifications}"
                              Margin="24,0,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 데이터 설정 -->
            <materialDesign:Card Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="데이터 설정" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="새로고침 간격 (초)" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" 
                                Value="{Binding RefreshInterval}"
                                Minimum="5" Maximum="60" 
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                TickPlacement="BottomRight" />
                    </Grid>
                    <TextBlock Text="{Binding RefreshInterval, StringFormat={}{0}초마다 새로고침}" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="150,0,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 언어 설정 -->
            <materialDesign:Card Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="언어 설정" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />

                    <ComboBox Width="200"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              materialDesign:HintAssist.Hint="언어 선택" />
                </StackPanel>
            </materialDesign:Card>

            <!-- API 설정 -->
            <materialDesign:Card Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="서버 연결" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />

                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="API 서버 URL"
                             Text="{Binding ApiBaseUrl}"
                             Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="연결 타임아웃:" VerticalAlignment="Center" />
                            <TextBox Text="{Binding ApiTimeout}"
                                     Width="60"
                                     Margin="8,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="초" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="연결 테스트"
                                Command="{Binding TestConnectionCommand}" />
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- 저장 버튼 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,32">
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Content="기본값으로 초기화"
                        Command="{Binding ResetToDefaultsCommand}"
                        Margin="0,0,16,0" />
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="설정 저장"
                        Command="{Binding SaveSettingsCommand}"
                        Width="120" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
