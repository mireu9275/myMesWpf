<UserControl x:Class="MesClient.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 페이지 헤더 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="대시보드" Style="{StaticResource PageTitle}" DockPanel.Dock="Left" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding RefreshDataCommand}"
                    Content="새로고침"
                    Margin="8,0,0,0">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" />
                            <TextBlock Text="새로고침" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
            <Border /> <!-- Spacer -->
        </DockPanel>

        <!-- KPI 카드들 -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,16">
            <!-- 오늘 생산 목표 -->
            <materialDesign:Card Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="오늘 생산 목표" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding TodayPlanQuantity, StringFormat=N0}" 
                               Style="{StaticResource KpiValue}" 
                               Margin="0,8,0,0" />
                    <TextBlock Text="EA" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 생산 실적 -->
            <materialDesign:Card Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="생산 실적" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding TodayProducedQuantity, StringFormat=N0}" 
                               Style="{StaticResource KpiValue}" 
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,8,0,0" />
                    <TextBlock Text="EA" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 달성률 -->
            <materialDesign:Card Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="달성률" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource KpiValue}" 
                               Foreground="{StaticResource SuccessBrush}"
                               Margin="0,8,0,0">
                        <Run Text="{Binding TodayAchievementRate, StringFormat=F1}" />
                        <Run Text="%" FontSize="18" />
                    </TextBlock>
                    <ProgressBar Value="{Binding TodayAchievementRate}" 
                                 Maximum="100" 
                                 Height="4" 
                                 Margin="0,8,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 불량률 -->
            <materialDesign:Card Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="불량률" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource KpiValue}" 
                               Foreground="{StaticResource WarningBrush}"
                               Margin="0,8,0,0">
                        <Run Text="{Binding TodayDefectRate, StringFormat=F2}" />
                        <Run Text="%" FontSize="18" />
                    </TextBlock>
                </StackPanel>
            </materialDesign:Card>

            <!-- 진행중 작업지시 -->
            <materialDesign:Card Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="진행중 작업" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding ActiveWorkOrderCount}" 
                               Style="{StaticResource KpiValue}" 
                               Foreground="{StaticResource InfoBrush}"
                               Margin="0,8,0,0" />
                    <TextBlock Text="건" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 설비 가동률 -->
            <materialDesign:Card Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="설비 가동" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding RunningEquipmentCount}" 
                                   Style="{StaticResource KpiValue}" 
                                   Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text=" / " 
                                   FontSize="24" 
                                   VerticalAlignment="Bottom" 
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalEquipmentCount}" 
                                   FontSize="24" 
                                   VerticalAlignment="Bottom"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="대" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </materialDesign:Card>
        </WrapPanel>

        <!-- 하단 영역 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <!-- 진행중 작업지시 목록 -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,8,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="진행중 작업지시" Style="{StaticResource SectionTitle}" Grid.Row="0" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ActiveWorkOrders}"
                              Style="{StaticResource MesDataGrid}"
                              SelectedItem="{Binding SelectedWorkOrder}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="작업지시번호" Binding="{Binding WorkOrderNo}" Width="120" />
                            <DataGridTextColumn Header="제품명" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="라인" Binding="{Binding LineName}" Width="80" />
                            <DataGridTextColumn Header="목표" Binding="{Binding PlanQuantity, StringFormat=N0}" Width="80" />
                            <DataGridTextColumn Header="실적" Binding="{Binding ProducedQuantity, StringFormat=N0}" Width="80" />
                            <DataGridTemplateColumn Header="진행률" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProgressRate, StringFormat={}{0:F1}%}" 
                                                       HorizontalAlignment="Center" />
                                            <ProgressBar Value="{Binding ProgressRate}" 
                                                         Maximum="100" 
                                                         Height="4" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="상태" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource WorkOrderStatusToColorConverter}}"
                                                CornerRadius="4"
                                                Padding="8,4">
                                            <TextBlock Text="{Binding Status}" 
                                                       Foreground="White" 
                                                       FontSize="11"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- 우측 패널 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 설비 현황 -->
                <materialDesign:Card Grid.Row="0" Margin="0,0,0,8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="설비 현황" Style="{StaticResource SectionTitle}" Grid.Row="0" />

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Equipments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" 
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            Padding="8">
                                        <DockPanel>
                                            <Border Style="{StaticResource StatusIndicator}"
                                                    Background="{Binding Status, Converter={StaticResource EquipmentStatusToColorConverter}}"
                                                    DockPanel.Dock="Left" />
                                            <StackPanel DockPanel.Dock="Left" Margin="8,0">
                                                <TextBlock Text="{Binding EquipmentName}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding LineName}" 
                                                           FontSize="11" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding CurrentWorkOrderNo}" 
                                                       DockPanel.Dock="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </materialDesign:Card>

                <!-- 활성 알람 -->
                <materialDesign:Card Grid.Row="1" Margin="0,8,0,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock Text="활성 알람" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" />
                            <materialDesign:Badged Badge="{Binding ActiveAlarms.Count}"
                                                   BadgeColorZoneMode="PrimaryDark"
                                                   DockPanel.Dock="Left"
                                                   Margin="8,0" />
                            <Border />
                        </DockPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ActiveAlarms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" 
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            Padding="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding AlarmName}" FontWeight="Medium" />
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                                                    <Run Text="{Binding EquipmentName}" />
                                                    <Run Text=" | " />
                                                    <Run Text="{Binding OccurredAt, StringFormat=HH:mm:ss}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    ToolTip="확인"
                                                    Command="{Binding DataContext.AcknowledgeAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsAcknowledged, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <materialDesign:PackIcon Kind="Check" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 알람 없음 -->
                        <TextBlock Grid.Row="1"
                                   Text="활성 알람이 없습니다"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding ActiveAlarms.Count, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>

        <!-- 로딩 오버레이 -->
        <Grid Grid.RowSpan="3" 
              Background="#80FFFFFF"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="48" Height="48" />
                <TextBlock Text="데이터를 불러오는 중..." 
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
