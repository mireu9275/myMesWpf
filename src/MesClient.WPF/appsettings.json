{
  "Api": {
    "BaseUrl": "http://localhost:5000",
    "TimeoutSeconds": 30,
    "RetryCount": 3
  },
  "Database": {
    "ConnectionString": "Server=.;Database=MES;Trusted_Connection=True;TrustServerCertificate=True;",
    "UseLocalCache": true
  },
  "Logging": {
    "LogPath": "logs",
    "RetainDays": 30,
    "MinimumLevel": "Information"
  },
  "Ui": {
    "Theme": "Light",
    "Language": "ko-KR",
    "RefreshIntervalSeconds": 10,
    "NotificationDurationSeconds": 5
  }
}
